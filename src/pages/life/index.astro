---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ValueHeatmap from "@/components/ValueHeatmap.astro"
import {
  values,
  passions,
  engagementPairs,
  habitMappings,
  getUncoveredValues,
} from "@/data/life-axes"

const uncovered = getUncoveredValues()
const activeHabits = habitMappings.filter((h) => !h.archived)

// 가치 축별로 관심 대상을 묶는다
const byValue = values.map((v) => ({
  value: v,
  items: passions.filter((p) => p.value === v.key),
}))
---

<BaseLayout
  title="Life Map"
  description="무엇에 몰입했고 어떻게 관여했는지를 세 겹의 축으로 기록합니다."
  activeHref="/life/"
>
  <div class="mx-auto max-w-4xl px-6 py-20 lg:px-16">
    <a href="/" class="text-sm text-gray-500 hover:underline">← 돌아가기</a>

    <p class="mt-8 font-mono text-xs tracking-widest text-gray-400">LIFE MAP</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-gray-900">
      삶을 기록하는 세 개의 축
    </h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-gray-600">
      왜 하는가(지덕체부복), 무엇을 하는가(관심 대상), 어떻게 관여하는가(방식).
      세 겹으로 기록합니다. 채워진 칸보다 비어 있는 칸이 더 많은 것을 말합니다.
    </p>

    <!-- 1. 활동 히트맵 -->
    <section class="mt-16">
      <h2 class="text-lg font-semibold text-gray-900">활동 기록</h2>
      <p class="mt-2 mb-8 text-sm text-gray-500">
        가치 축별 주간 활동. TickTick 습관 체크인에서 가져옵니다.
      </p>

      <ValueHeatmap />

      {
        uncovered.length > 0 && (
          <p class="mt-6 text-sm text-gray-500">
            {uncovered.map((v) => v.name).join("과 ")}은 아직 추적하는 습관이 없어
            빈 줄로 남아 있습니다. 채우려고 꾸미지 않습니다. 습관은 만들어 가는 것이고,
            비어 있다는 사실 자체가 지금의 기록입니다.
          </p>
        )
      }
      <p class="mt-2 text-sm text-gray-400">
        현재 추적 중인 습관 {activeHabits.length}개 — {
          activeHabits.map((h) => h.name).join(", ")
        }
      </p>
    </section>

    <!-- 2. 가치 축과 관심 대상 -->
    <section class="mt-20">
      <h2 class="text-lg font-semibold text-gray-900">무엇에 시간을 쓰는가</h2>
      <p class="mt-2 text-sm text-gray-500">
        지덕체부복 다섯 축과, 그 아래 실제로 시간을 쏟는 대상들.
      </p>

      <dl class="mt-8 divide-y divide-rule border-t border-rule">
        {
          byValue.map(({ value, items }) => (
            <div class="py-5 sm:flex sm:gap-8">
              <dt class="w-32 shrink-0">
                <span class="font-semibold text-gray-900">{value.name}</span>
                <span class="ml-1 font-mono text-xs text-gray-400">{value.hanja}</span>
                <p class="mt-0.5 text-xs text-gray-500">{value.description}</p>
              </dt>
              <dd class="mt-2 flex flex-wrap gap-x-4 gap-y-1 sm:mt-0">
                {items.length === 0 ? (
                  <span class="text-sm text-gray-300">아직 없음</span>
                ) : (
                  items.map((p) => (
                    <span
                      class:list={[
                        "text-sm",
                        p.planned ? "text-gray-300" : "text-gray-600",
                      ]}
                      title={p.planned ? "앞으로 해보려는 것" : undefined}
                    >
                      {p.name}
                      {p.planned && <span class="ml-0.5 text-[10px]">예정</span>}
                    </span>
                  ))
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 3. 방식 축 -->
    <section class="mt-20">
      <h2 class="text-lg font-semibold text-gray-900">어떻게 관여하는가</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-500">
        네 쌍의 대비되는 방식. 한쪽에 치우치지 않는 것이 목표입니다. 각 방식에는
        판정 질문을 하나씩 붙여 두었습니다. 기록할 때마다 고민하지 않기 위해서고,
        질문에 답이 안 나오면 그 쌍은 비워 둡니다.
      </p>

      <div class="mt-10 space-y-12">
        {
          engagementPairs.map((pair, i) => (
            <div>
              <p class="font-mono text-xs tracking-widest text-gray-400">
                {String(i + 1).padStart(2, "0")} — {pair.axis}
              </p>

              <div class="mt-4 grid gap-6 sm:grid-cols-2">
                {[pair.left, pair.right].map((e) => (
                  <div class="border-t border-rule pt-4">
                    <h3 class="font-semibold text-gray-900">{e.name}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-gray-600">{e.summary}</p>
                    <p class="mt-3 text-sm text-brand-600">{e.test}</p>
                    <p class="mt-2 text-xs text-gray-400">{e.examples.join(" · ")}</p>
                  </div>
                ))}
              </div>

              <ul class="mt-5 space-y-1 border-l-2 border-rule pl-4">
                {pair.edgeCases.map((c) => (
                  <li class="text-xs leading-relaxed text-gray-500">{c}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4. 기록 목록 -->
    <section class="mt-20 border-t border-rule pt-10">
      <h2 class="text-lg font-semibold text-gray-900">기록</h2>
      <p class="mt-2 text-sm text-gray-400">
        TODO — life 컬렉션. 개별 경험 기록과 세 축 태깅.
      </p>
    </section>
  </div>
</BaseLayout>
