---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/Section.astro"
import { profile } from "@/data/site"
import { now } from "@/data/now"
import { getPublicTimeline } from "@/data/experience"
import { getCollection } from "astro:content"
import { knowledgeAreas, matchAreas } from "@/data/knowledge"
import ValueHeatmap from "@/components/ValueHeatmap.astro"

const experience = getPublicTimeline()

// 지식 영역별 노트 개수. 선언이 아니라 축적으로 드러낸다.
// 개수가 적은 영역은 결핍이 아니라 다음에 쓸 것의 목록이다.
const publishedNotes = (await getCollection("notes")).filter((n) => !n.data.draft)
const noteCounts = new Map<string, number>()
for (const n of publishedNotes) {
  for (const a of matchAreas({ title: n.data.title, tags: n.data.tags })) {
    noteCounts.set(a.slug, (noteCounts.get(a.slug) ?? 0) + 1)
  }
}

/** 아직 구현 전인 섹션에 남기는 표시 */
const pending = "구현 예정"
---

<BaseLayout>
  <!-- Hero -->
  <section id="about" class="px-6 pt-24 pb-20 lg:px-16 lg:pt-32 lg:pb-20">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-xs tracking-widest text-gray-400">01 — ABOUT</p>

      <h1
        class="mt-6 max-w-2xl text-3xl leading-snug font-semibold tracking-tight text-gray-900 lg:text-4xl"
      >
        현실에서 작동하는 구조를 찾고,<br />그 과정을 기록합니다.
      </h1>

      <div class="mt-8 max-w-2xl space-y-4 leading-relaxed text-gray-600">
        <p>
          안녕하세요, <span class="text-gray-900">{profile.nameKo}</span>입니다.
          {profile.tagline}
        </p>
        <p>
          이 사이트는 제 사고의 public surface입니다. 완성된 글보다 사고의 흔적을 남기는
          공간입니다.
        </p>
      </div>
    </div>
  </section>

  <!-- Knowledge — 이 사이트의 중심축 -->
  <Section
    id="knowledge"
    index="02"
    title="Knowledge"
    description="무엇을 잘하는지가 아니라, 무엇을 알아가고 있는지를 남깁니다."
    action={{ label: "전체 노트 보기", href: "/notes/" }}
  >
    <ol class="divide-y divide-rule border-t border-rule">
      {
        knowledgeAreas.map((area, i) => (
          <li class="py-6">
            <div class="sm:flex sm:gap-8">
              <div class="w-40 shrink-0">
                <p class="font-mono text-xs text-gray-400">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <h3 class="mt-1 font-semibold text-gray-900">
                  {area.name}
                  <span class="ml-1.5 font-mono text-xs font-normal text-gray-400">
                    {noteCounts.get(area.slug) ?? 0}
                  </span>
                </h3>
              </div>
              <div class="mt-2 sm:mt-0">
                <p class="text-sm leading-relaxed text-gray-600">{area.description}</p>
                <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
                  {area.topics.map((t) => (
                    <li class="text-sm text-gray-400">{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Now — 문장으로 답하는 "지금", 그 아래 데이터로 답하는 "지금" -->
  <Section
    id="now"
    index="03"
    title="Now"
    description="지금 무엇에 시간을 쓰고 있는지."
  >
    <ul class="space-y-6">
      {
        now.items.map((item) => (
          <li class="border-l-2 border-brand-200 pl-5">
            <h3 class="font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-1 leading-relaxed text-gray-600">{item.detail}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 border-t border-rule pt-10">
      <h3 class="font-semibold text-gray-900">활동 기록</h3>
      <p class="mt-2 mb-8 max-w-2xl text-sm leading-relaxed text-gray-500">
        '지덕체부복' 다섯 축의 주간 활동을 모니터링합니다.
      </p>

      <ValueHeatmap />
    </div>
  </Section>

  <!-- Experience (조직명을 가린 추상화 형태) -->
  <Section
    id="experience"
    index="04"
    title="Experience"
    description="어디에 있었는지보다 무엇을 다뤄왔는지를 남깁니다."
  >
    {
      experience.length === 0 ? (
        <p class="text-sm text-gray-400">{pending}</p>
      ) : (
        <ol class="space-y-12">
          {experience.map((item) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-semibold text-gray-900">{item.title}</h3>
                {item.organizationLabel && (
                  <span class="font-mono text-xs text-gray-400">
                    {item.organizationLabel}
                  </span>
                )}
              </div>

              {item.summary && (
                <p class="mt-3 max-w-2xl leading-relaxed text-gray-600">{item.summary}</p>
              )}

              {item.domains && item.domains.length > 0 && (
                <dl class="mt-6 divide-y divide-rule border-t border-rule">
                  {item.domains.map((d) => (
                    <div class="py-3 sm:flex sm:gap-6">
                      <dt class="w-24 shrink-0 text-sm text-gray-900">{d.name}</dt>
                      <dd class="text-sm leading-relaxed text-gray-500">{d.detail}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </Section>

  <!-- Projects -->
  <Section
    id="projects"
    index="05"
    title="Projects"
    description="Lab에서 굴리고 있는 실험들입니다."
    action={{ label: "전체 보기", href: "/projects/" }}
  >
    <p class="text-sm text-gray-400">{pending} — 공개 범위 선별 후 구현</p>
  </Section>

</BaseLayout>
