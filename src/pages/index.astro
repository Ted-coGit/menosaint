---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/Section.astro"
import { profile } from "@/data/site"
import { now } from "@/data/now"
import { getPublicTimeline, getYearsOfExperience } from "@/data/experience"
import { knowledgeAreas } from "@/data/knowledge"
import { getUncoveredValues } from "@/data/values"
import ValueHeatmap from "@/components/ValueHeatmap.astro"

// 통계는 데이터 파일에서 계산한다. 값이 없으면 아예 렌더링하지 않는다.
const stats = [
  { value: getYearsOfExperience(), label: "YEARS", caption: "경력" },
].filter((s) => s.value !== null)

const experience = getPublicTimeline()
const uncovered = getUncoveredValues()

const nowYear = Number(now.updated.split("-")[0])
const nowMonth = Number(now.updated.split("-")[1])

/** 아직 구현 전인 섹션에 남기는 표시 */
const pending = "구현 예정"
---

<BaseLayout>
  <!-- Hero -->
  <section id="about" class="px-6 py-24 lg:px-16 lg:py-32">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-xs tracking-widest text-gray-400">01 — ABOUT</p>

      <h1
        class="mt-6 max-w-2xl text-3xl leading-snug font-semibold tracking-tight text-gray-900 lg:text-4xl"
      >
        현실에서 작동하는 구조를 찾고,<br />그 과정을 기록합니다.
      </h1>

      <div class="mt-8 max-w-xl space-y-4 leading-relaxed text-gray-600">
        <p>
          안녕하세요, <span class="text-gray-900">{profile.nameKo}</span>입니다.
          {profile.tagline}
        </p>
        <p>
          이 사이트는 제 사고의 public surface입니다. 완성된 글보다 사고의 흔적을 남기는
          공간입니다.
        </p>
      </div>

      {
        stats.length > 0 && (
          <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4 border-t border-rule pt-6">
            {stats.map((s) => (
              <div class="flex items-baseline gap-2">
                <dd class="font-mono text-2xl text-gray-900">{s.value}</dd>
                <dt class="text-sm text-gray-500">{s.caption}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- Knowledge — 이 사이트의 중심축 -->
  <Section
    id="knowledge"
    index="02"
    title="Knowledge"
    description="무엇을 잘하는지가 아니라, 무엇을 알아가고 있는지를 남깁니다."
    action={{ label: "전체 노트 보기", href: "/notes/" }}
  >
    <ol class="divide-y divide-rule border-t border-rule">
      {
        knowledgeAreas.map((area, i) => (
          <li class="py-6">
            <div class="sm:flex sm:gap-8">
              <div class="w-40 shrink-0">
                <p class="font-mono text-xs text-gray-400">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <h3 class="mt-1 font-semibold text-gray-900">{area.name}</h3>
              </div>
              <div class="mt-2 sm:mt-0">
                <p class="text-sm leading-relaxed text-gray-600">{area.description}</p>
                <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
                  {area.topics.map((t) => (
                    <li class="text-sm text-gray-400">{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-sm text-gray-400">
      영역을 누르면 그 주제로 쓴 노트가 열리는 연결은 노트 컬렉션 구현 후에 붙는다.
    </p>
  </Section>

  <!-- Now — 문장으로 답하는 "지금", 그 아래 데이터로 답하는 "지금" -->
  <Section
    id="now"
    index="03"
    title="Now"
    description={`${nowYear}년 ${nowMonth}월 기준. 지금 무엇에 시간을 쓰고 있는지.`}
  >
    <ul class="space-y-6">
      {
        now.items.map((item) => (
          <li class="border-l-2 border-brand-200 pl-5">
            <h3 class="font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-1 leading-relaxed text-gray-600">{item.detail}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 border-t border-rule pt-10">
      <h3 class="font-semibold text-gray-900">활동 기록</h3>
      <p class="mt-2 mb-8 max-w-2xl text-sm leading-relaxed text-gray-500">
        위가 의도라면 아래는 실제입니다. 지덕체부복 다섯 축의 주간 활동을
        TickTick 습관 체크인에서 가져옵니다. 무엇을 했는지는 남기지 않고 횟수만 셉니다.
      </p>

      <ValueHeatmap />

      {
        uncovered.length > 0 && (
          <p class="mt-6 max-w-2xl text-sm leading-relaxed text-gray-500">
            {uncovered.map((v) => v.name).join("과 ")}은 아직 추적하는 습관이 없어 빈
            줄로 남아 있습니다. 채우려고 꾸미지 않습니다. 기록을 시작하는 시점이
            지금이고, 비어 있다는 사실도 기록입니다.
          </p>
        )
      }
    </div>
  </Section>

  <!-- Experience (조직명을 가린 추상화 형태) -->
  <Section
    id="experience"
    index="04"
    title="Experience"
    description="어디에 있었는지보다 무엇을 다뤄왔는지를 남깁니다."
  >
    {
      experience.length === 0 ? (
        <p class="text-sm text-gray-400">{pending}</p>
      ) : (
        <ol class="space-y-12">
          {experience.map((item) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-semibold text-gray-900">{item.title}</h3>
                {item.organizationLabel && (
                  <span class="font-mono text-xs text-gray-400">
                    {item.organizationLabel}
                  </span>
                )}
              </div>

              {item.summary && (
                <p class="mt-3 max-w-2xl leading-relaxed text-gray-600">{item.summary}</p>
              )}

              {item.domains && item.domains.length > 0 && (
                <dl class="mt-6 divide-y divide-rule border-t border-rule">
                  {item.domains.map((d) => (
                    <div class="py-3 sm:flex sm:gap-6">
                      <dt class="w-24 shrink-0 text-sm text-gray-900">{d.name}</dt>
                      <dd class="text-sm leading-relaxed text-gray-500">{d.detail}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </Section>

  <!-- Projects -->
  <Section
    id="projects"
    index="05"
    title="Projects"
    description="Lab에서 굴리고 있는 실험들입니다."
    action={{ label: "전체 보기", href: "/projects/" }}
  >
    <p class="text-sm text-gray-400">{pending} — 공개 범위 선별 후 구현</p>
  </Section>

</BaseLayout>
