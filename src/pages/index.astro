---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/Section.astro"
import { profile } from "@/data/site"
import { now } from "@/data/now"
import { getPublicTimeline, getYearsOfExperience } from "@/data/experience"
import { skillGroups } from "@/data/skills"

// 통계는 데이터 파일에서 계산한다. 값이 없으면 아예 렌더링하지 않는다.
const stats = [
  { value: getYearsOfExperience(), label: "YEARS", caption: "경력" },
].filter((s) => s.value !== null)

const experience = getPublicTimeline()

const nowYear = Number(now.updated.split("-")[0])
const nowMonth = Number(now.updated.split("-")[1])

/** 아직 구현 전인 섹션에 남기는 표시 */
const pending = "구현 예정"
---

<BaseLayout>
  <!-- Hero -->
  <section id="about" class="border-b border-gray-100 px-6 py-24 lg:px-16">
    <div class="mx-auto max-w-4xl">
      <p class="text-gray-600">
        안녕하세요, <strong class="font-semibold text-gray-900">{profile.nameKo}</strong>입니다.
      </p>

      <h1 class="mt-4 text-5xl leading-none font-black tracking-tight lg:text-7xl">
        <span class="block text-gray-900">MENO</span>
        <span class="block text-brand-600">SAINT</span>
      </h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-gray-700">
        {profile.tagline}
      </p>
      <p class="mt-4 max-w-xl leading-relaxed text-gray-600">
        현실 문제를 구조적으로 바라보고, 그 과정을 기록합니다.<br />
        이 사이트는 제 사고의 public surface입니다.
      </p>

      {
        stats.length > 0 && (
          <dl class="mt-12 flex flex-wrap gap-x-12 gap-y-6">
            {stats.map((s) => (
              <div>
                <dd class="text-4xl font-bold text-brand-600">{s.value}+</dd>
                <dt class="mt-1 text-xs font-semibold tracking-wider text-gray-900">
                  {s.label}
                </dt>
                <p class="text-xs text-gray-500">{s.caption}</p>
              </div>
            ))}
          </dl>
        )
      }

      <p class="mt-12 text-brand-600">
        지금 쓰는 <a href="/notes/" class="font-semibold hover:underline">글</a>과
        만드는 <a href="/projects/" class="font-semibold hover:underline">것들</a>.
      </p>
    </div>
  </section>

  <!-- Now -->
  <Section
    id="now"
    title="Now"
    description={`${nowYear}년 ${nowMonth}월 기준. 지금 무엇에 시간을 쓰고 있는지.`}
  >
    <ul class="space-y-6">
      {
        now.items.map((item) => (
          <li class="border-l-2 border-brand-200 pl-5">
            <h3 class="font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-1 leading-relaxed text-gray-600">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Experience (조직명을 가린 추상화 형태) -->
  <Section
    id="experience"
    title="Experience"
    description="어디에 있었는지보다 무엇을 다뤄왔는지를 남깁니다."
  >
    {
      experience.length === 0 ? (
        <p class="text-sm text-gray-400">{pending}</p>
      ) : (
        <ol class="space-y-10">
          {experience.map((item) => (
            <li class="rounded-xl bg-gray-50 p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-lg font-bold text-gray-900">{item.title}</h3>
                {item.organizationLabel && (
                  <span class="text-sm text-gray-500">{item.organizationLabel}</span>
                )}
              </div>

              {item.summary && (
                <p class="mt-3 leading-relaxed text-gray-600">{item.summary}</p>
              )}

              {item.domains && item.domains.length > 0 && (
                <dl class="mt-5 space-y-3 border-t border-gray-200 pt-5">
                  {item.domains.map((d) => (
                    <div class="sm:flex sm:gap-4">
                      <dt class="w-28 shrink-0 text-sm font-semibold text-brand-600">
                        {d.name}
                      </dt>
                      <dd class="text-sm leading-relaxed text-gray-600">{d.detail}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </Section>

  <!-- Skills -->
  <Section
    id="skills"
    title="Skills"
    description="기술을 클릭하면 관련 노트를 확인할 수 있습니다."
    action={{ label: "전체 노트 보기", href: "/notes/" }}
  >
    <div class="space-y-8">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="text-xs font-semibold tracking-wider text-gray-500 uppercase">
              {group.category}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li class="rounded-full border border-gray-200 px-4 py-1.5 text-sm text-gray-700">
                  {skill.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-gray-400">
      노트 태그 연동은 Phase 3에서 붙인다. 지금은 목록만 표시된다.
    </p>
  </Section>

  <!-- Projects -->
  <Section
    id="projects"
    title="Projects"
    description="Lab에서 굴리고 있는 실험들입니다."
    action={{ label: "전체 보기", href: "/projects/" }}
  >
    <p class="text-sm text-gray-400">{pending} — Card + Detail Panel</p>
  </Section>

  <!-- Life -->
  <Section
    id="life"
    title="Life"
    description="무엇에 몰입했고 어떻게 관여했는지를 기록합니다."
    action={{ label: "Life Map 보기", href: "/life/" }}
    class="border-b-0"
  >
    <p class="text-sm text-gray-400">{pending} — 두 축(열정 × 방식) 기록과 그래프</p>
  </Section>
</BaseLayout>
