---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="찾을 수 없음" description="요청한 페이지가 없습니다.">
  <div class="mx-auto max-w-4xl px-6 py-32 lg:px-16">
    <p class="font-mono text-xs tracking-widest text-gray-400">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight text-gray-900">
      여기엔 아무것도 없습니다.
    </h1>
    <p class="mt-3 text-gray-600">
      주소가 바뀌었거나 글이 내려갔을 수 있습니다.
    </p>
    <p class="mt-8 flex gap-6 text-sm">
      <a href="/" class="border-b border-gray-300 pb-0.5 text-gray-600 hover:border-brand-600 hover:text-brand-600">
        처음으로
      </a>
      <a href="/notes/" class="border-b border-gray-300 pb-0.5 text-gray-600 hover:border-brand-600 hover:text-brand-600">
        노트 전체
      </a>
    </p>
  </div>
</BaseLayout>
