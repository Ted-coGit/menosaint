---
interface Props {
  id: string
  title: string
  description?: string
  /** 우측 상단 링크 (예: 전체 목록 보기) */
  action?: { label: string; href: string }
  class?: string
}
const { id, title, description, action, class: className = "" } = Astro.props
---

<section id={id} class={`border-b border-gray-100 px-6 py-20 lg:px-16 ${className}`}>
  <div class="mx-auto max-w-4xl">
    <div class="flex items-start justify-between gap-6">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">{title}</h2>
        {description && <p class="mt-2 text-gray-500">{description}</p>}
      </div>
      {
        action && (
          <a
            href={action.href}
            class="shrink-0 text-sm font-medium text-brand-600 hover:underline"
          >
            {action.label} →
          </a>
        )
      }
    </div>

    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
