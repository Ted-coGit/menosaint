---
interface Props {
  id: string
  title: string
  /** 좌측에 표시할 순번. "01" 형태로 넘긴다 */
  index?: string
  description?: string
  /** 우측 상단 링크 (예: 전체 목록 보기) */
  action?: { label: string; href: string }
  class?: string
}
const { id, title, index, description, action, class: className = "" } = Astro.props
---

<section id={id} class={`border-t border-rule px-6 py-20 lg:px-16 ${className}`}>
  <div class="mx-auto max-w-4xl">
    {
      index && (
        <p class="font-mono text-xs tracking-widest text-gray-400">
          {index} — {title.toUpperCase()}
        </p>
      )
    }

    <div class="mt-3 flex items-start justify-between gap-6">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900">{title}</h2>
        {description && <p class="mt-2 text-sm text-gray-500">{description}</p>}
      </div>
      {
        action && (
          <a
            href={action.href}
            class="shrink-0 border-b border-gray-300 pb-0.5 text-sm text-gray-600 transition-colors hover:border-brand-600 hover:text-brand-600"
          >
            {action.label}
          </a>
        )
      }
    </div>

    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
