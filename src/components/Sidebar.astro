---
import { profile, socials, nav, site } from "@/data/site"
import SocialIcon from "./SocialIcon.astro"

interface Props {
  /** 별도 라우트에서 활성 표시할 nav href (예: "/notes/") */
  activeHref?: string
}
const { activeHref } = Astro.props
---

<!-- 모바일 햄버거 -->
<button
  id="mobile-menu-btn"
  type="button"
  class="fixed top-4 left-4 z-50 rounded-md border border-rule bg-paper p-2.5 text-gray-700 shadow-sm lg:hidden"
  aria-label="메뉴 열기"
  aria-expanded="false"
  aria-controls="sidebar"
>
  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
  </svg>
</button>

<!-- 모바일 오버레이 -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-30 hidden bg-gray-900/20 lg:hidden"
  aria-hidden="true"
>
</div>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-sidebar -translate-x-full flex-col border-r border-rule bg-paper transition-transform duration-200 lg:translate-x-0"
>
  <div class="flex flex-1 flex-col overflow-y-auto px-7 py-10">
    <!-- 워드마크. 인물 사진 대신 활자로 -->
    <a href="/" class="group block">
      <span class="font-mono text-lg tracking-tight text-gray-900"
        >{site.name}<span class="text-brand-600">.</span></span
      >
      <p class="mt-1 text-xs text-gray-500">{profile.role}</p>
    </a>

    <!-- 내비게이션. 좌측 정렬, 활성 표시는 채움이 아니라 좌측 괘선 -->
    <nav class="mt-12 flex flex-col" aria-label="주요 섹션">
      {
        nav.map((item) => {
          const href = item.anchor ? `/#${item.anchor}` : item.href!
          const isActive = activeHref !== undefined && item.href === activeHref
          return (
            <a
              href={href}
              data-nav
              data-anchor={item.anchor}
              class:list={[
                "-ml-px border-l py-1.5 transition-colors",
                item.sub
                  ? "pl-7 text-xs text-gray-400 hover:text-gray-600"
                  : "pl-4 text-sm text-gray-600 hover:text-gray-900",
                isActive
                  ? "border-brand-600 font-medium text-gray-900"
                  : "border-rule",
              ]}
            >
              {item.label}
            </a>
          )
        })
      }
    </nav>
  </div>

  <!-- 하단 -->
  <div class="flex items-center gap-4 border-t border-rule px-7 py-5">
    {
      socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          class="text-gray-400 transition-colors hover:text-gray-900"
        >
          <SocialIcon icon={s.icon} class="h-4 w-4" />
        </a>
      ))
    }
  </div>
</aside>

<script>
  // 모바일 토글
  const btn = document.getElementById("mobile-menu-btn")
  const sidebar = document.getElementById("sidebar")
  const overlay = document.getElementById("sidebar-overlay")

  function setOpen(open: boolean) {
    if (!sidebar || !overlay || !btn) return
    sidebar.classList.toggle("-translate-x-full", !open)
    overlay.classList.toggle("hidden", !open)
    // 열려 있는 동안 햄버거가 사이드바 위에 겹치지 않게 숨긴다
    btn.classList.toggle("hidden", open)
    btn.setAttribute("aria-expanded", String(open))
  }

  btn?.addEventListener("click", () =>
    setOpen(btn.getAttribute("aria-expanded") !== "true"),
  )
  overlay?.addEventListener("click", () => setOpen(false))
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false)
  })

  // 스크롤 스파이: 현재 보이는 섹션의 nav 항목을 강조
  const ACTIVE = ["border-brand-600", "font-medium", "text-gray-900"]
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav][data-anchor]"),
  )
  const sections = links
    .map((l) => document.getElementById(l.dataset.anchor!))
    .filter((el): el is HTMLElement => el !== null)

  if (sections.length > 0) {
    const active = new Set<string>()

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) active.add(entry.target.id)
          else active.delete(entry.target.id)
        }
        // 문서 순서상 가장 위에 있는 활성 섹션 하나만 강조
        const current = sections.find((s) => active.has(s.id))?.id
        for (const link of links) {
          const on = link.dataset.anchor === current
          link.classList.toggle("border-rule", !on)
          ACTIVE.forEach((c) => link.classList.toggle(c, on))
        }
      },
      { rootMargin: "-20% 0px -70% 0px" },
    )

    sections.forEach((s) => observer.observe(s))
  }
</script>
